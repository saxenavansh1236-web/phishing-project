    ("saxenavansh1236@gmail.com", "https://dgu.ac/",                   "SAFE URL ✅",      10),
]


# ── Seed Function ──────────────────────────────────────────────

def seed(db_path: str = "users.db") -> None:
    conn = sqlite3.connect(db_path)
    conn.executescript(SCHEMA)

    conn.executemany(
        "INSERT OR IGNORE INTO users (username, password) VALUES (?, ?)",
        USERS,
    )

    conn.executemany(
        "INSERT INTO history (username, url, result, risk) VALUES (?, ?, ?, ?)",
        HISTORY,
    )

    conn.commit()

    user_count    = conn.execute("SELECT COUNT(*) FROM users").fetchone()[0]
    history_count = conn.execute("SELECT COUNT(*) FROM history").fetchone()[0]
    conn.close()

    print(f"✅ Seeded {user_count} user(s) and {history_count} history record(s) into '{db_path}'.")


if __name__ == "__main__":
    seed()