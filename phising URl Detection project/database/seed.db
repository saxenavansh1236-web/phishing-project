    ("saxenavansh1236@gmail.com", "https://vgu.ac.in",                 "SAFE URL ✅",      10),
    ("saxenavansh1236@gmail.com", "https://dgu.ac/",                   "SAFE URL ✅",      10),
    ("saxenavansh1236@gmail.com", "https://vgu.ac.in",                 "SAFE URL ✅",      10),
    ("saxenavansh1236@gmail.com", "https://vgu.ac.in",                 "SAFE URL ✅",      10),
    ("saxenavansh1236@gmail.com", "netflix.com",                       "SAFE URL ✅",      10),
    ("saxenavansh1236@gmail.com", "netfix.com",                        "SAFE URL ✅",      10),
